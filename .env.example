# ─────────────────────────────────────────────────────────────
#  SmileCare CRM · settings template
#  Local:  copy this file to ".env" and fill in the values.
#  Vercel: add the same names under Project → Settings → Environment Variables.
#  Never commit or share a file that contains the real key.
# ─────────────────────────────────────────────────────────────

# Bolna API key (platform.bolna.ai → Developers → API Keys). Leave as-is for DEMO mode.
BOLNA_API_KEY=your-bolna-api-key-here

# The confirmation voice agent (already created on Bolna)
BOLNA_AGENT_ID=106ac92f-41e1-4e2e-9c7f-dca769d5bcb6

# Optional: a phone number on the Bolna account to call FROM (e.g. +918035xxxxxx)
BOLNA_FROM_NUMBER=

# Optional but recommended on a public URL: visitors must type this code before
# the app will place real calls (protects the Bolna wallet).
ACCESS_CODE=
